#!/bin/bash
# ============================================================
# ブログのアイキャッチ画像を3アプリまとめて作り直すスクリプト
#
# 使い方: ターミナルにこの1行を貼るだけです
#   bash "/Users/yuri/Downloads/AI멘토 Jay/開発したAI/ブログ画像を作り直す.command"
#
# やること:
#   1. 3アプリに sharp（画像圧縮ライブラリ）を入れる
#   2. 既存の重い画像を圧縮する（無料）
#   3. 壊れている画像・低品質な画像を新モデルで作り直す（約60枚 / 約$8）
# 途中で止めたいときは control + C。もう一度実行すれば続きから再開します。
# ============================================================
set -u

ROOT="/Users/yuri/Downloads/AI멘토 Jay/開発したAI"
APPS=("ReRoomAI" "WallAI" "Studio AI")

echo ""
echo "=================================================="
echo " ブログ画像の作り直しを開始します"
echo " 開始時刻: $(date '+%H:%M:%S')"
echo "=================================================="

for APP in "${APPS[@]}"; do
  echo ""
  echo "──────────────────────────────────────────────────"
  echo " [$APP] 1/2 sharp を準備しています..."
  echo "──────────────────────────────────────────────────"
  cd "$ROOT/$APP" || { echo "フォルダが見つかりません: $ROOT/$APP"; continue; }
  npm install --silent --no-audit --no-fund || { echo "[$APP] npm install に失敗しました"; continue; }

  echo ""
  echo "──────────────────────────────────────────────────"
  echo " [$APP] 2/2 画像を圧縮・作り直ししています..."
  echo "──────────────────────────────────────────────────"
  node scripts/regenerate-eyecatch.mjs || echo "[$APP] 途中で失敗しました（もう一度実行すれば続きから再開します）"
done

echo ""
echo "=================================================="
echo " すべて完了しました"
echo " 終了時刻: $(date '+%H:%M:%S')"
echo "=================================================="
echo ""
echo "画像を確認するには:"
for APP in "${APPS[@]}"; do
  echo "  open \"$ROOT/$APP/public/blog\""
done
echo ""
echo "問題がなければ、3アプリともコミットしてプッシュしてください。"
echo ""
